# Journey (Infocom, v6, release 83, version PC) avec ses images VGA (JOURNEY.MG1, hors dépôt) : image titre
# (Espace à 120 M cycles pour la question de reprise, Entrée en HID à 400 M), puis écran d'introduction :
# image 2 à gauche (colonnes 0-28, rangées 1-17), texte à droite ; Échap à 800 M arrête la version de test.
STORY=../infocom-masterpieces/ibm/journey/JOURNEY.ZIP
OPTS="-pics ../infocom-masterpieces/ibm/journey/JOURNEY.MG1"
SI_PRESENT=1
KEYS=' '
KEYSTART=120000000
HIDKEYS=28
HIDSTART=400000000
HIDKEYS2=29
HIDSTART2=800000000
CYCLES=1000000000
MODE=4
IMAGES='^erreur 00 dessins 2 rangees 0 (29 ){17}0 0 0 0 0 0 0$'
